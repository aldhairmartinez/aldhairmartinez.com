# Copy to .env.local for local development.
# All variables here are safe to expose to the browser (NEXT_PUBLIC_*) —
# nothing in this file is a secret. Do not put API keys or write tokens here;
# static-exported sites ship every env var referenced in client code to the
# browser bundle.

# Canonical site URL, used for metadata, sitemap, and OG tags.
# Leave unset locally (defaults to https://aldhairmartinez.com in code) or
# point it at your Cloudflare Pages preview URL while the custom domain is
# not yet attached.
NEXT_PUBLIC_SITE_URL=https://aldhairmartinez.com

# --- Grafana Faro (frontend observability) ---
# Optional. When unset, Faro does not initialize and the site behaves as a
# plain static site. Set these once a real Grafana Cloud Frontend
# Observability collector endpoint exists.
NEXT_PUBLIC_FARO_URL=
NEXT_PUBLIC_FARO_APP_NAME=aldhairmartinez-com
NEXT_PUBLIC_FARO_ENVIRONMENT=production

# --- Backend API (see /backend, V2 work-in-progress) ---
# Optional. When unset, the contact form does not render and the contact
# page falls back to the static email/GitHub/LinkedIn links only. Local dev
# only for now — there is no production deployment of the backend yet.
# Run the backend with `docker compose up` and set this to its local URL —
# use your machine's LAN IP (e.g. http://192.168.1.50:8000) instead of
# localhost if you also want to test from a phone on the same Wi-Fi (also
# set DEV_LAN_ORIGIN below in that case); it still works from your own
# machine's browser too.
NEXT_PUBLIC_API_URL=

# --- LAN/mobile dev testing (optional) ---
# Only needed to test the dev server (`npm run dev`) from another device
# (e.g. a phone) on the same Wi-Fi - lets that device load dev JS chunks
# (HMR, bundles) so the site actually hydrates there. Set to your machine's
# LAN IP (e.g. 192.168.1.50). Leave unset for localhost-only development;
# has no effect on the production static export build.
DEV_LAN_ORIGIN=
