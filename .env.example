# Copy to .env.local for local development.
# All variables here are safe to expose to the browser (NEXT_PUBLIC_*) —
# nothing in this file is a secret. Do not put API keys or write tokens here;
# static-exported sites ship every env var referenced in client code to the
# browser bundle.

# Canonical site URL, used for metadata, sitemap, and OG tags.
# Leave unset locally (defaults to https://aldhairmartinez.com in code) or
# point it at your Cloudflare Pages preview URL while the custom domain is
# not yet attached.
NEXT_PUBLIC_SITE_URL=https://aldhairmartinez.com

# --- Grafana Faro (frontend observability) ---
# Optional. When unset, Faro does not initialize and the site behaves as a
# plain static site. Set these once a real Grafana Cloud Frontend
# Observability collector endpoint exists.
NEXT_PUBLIC_FARO_URL=
NEXT_PUBLIC_FARO_APP_NAME=aldhairmartinez-com
NEXT_PUBLIC_FARO_ENVIRONMENT=production
