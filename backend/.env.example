# Copy to backend/.env for local development. docker-compose.yml loads that
# file via `env_file:`. backend/.env is gitignored — never commit real
# values, especially RESEND_API_KEY.

# Comma-separated list of origins allowed to call this API from the browser.
# Optional - defaults to http://localhost:3000 if unset (see backend/main.py).
# Add your machine's LAN IP (e.g. http://192.168.1.50:3000) alongside
# localhost if you also want to test the contact form from a phone on the
# same Wi-Fi - matches whatever you set DEV_LAN_ORIGIN/NEXT_PUBLIC_API_URL to
# on the frontend side (see the root .env.example).
CORS_ORIGINS=http://localhost:3000

# --- Resend (outbound email for POST /api/contact) ---
# Required. Get this from https://resend.com/api-keys. Never commit a real
# value — this must only ever exist in backend/.env.
RESEND_API_KEY=

# Optional. Who the contact form actually emails. Defaults to hello@ if
# unset. Point this at a personal inbox during testing if you want.
CONTACT_TO_EMAIL=

# Optional. Must be an address on a domain verified with Resend. Defaults to
# noreply@aldhairmartinez.com if unset.
CONTACT_FROM_EMAIL=

# --- PostgreSQL (local Docker, foundation only — no feature uses this yet) ---
# These credentials are entirely local/arbitrary (nothing external to fetch)
# and are shared by both the postgres and backend services via this same
# file. Never commit real values.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Shared secret for POST /api/deployments (the one write endpoint meant for
# CI/CD, not visitors). Arbitrary local value, nothing external to fetch —
# generate your own, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(24))"`.
DEPLOY_TOKEN=

# --- OpenTelemetry (backend traces) ---
# No config needed here anymore. OTEL_EXPORTER_OTLP_ENDPOINT is set directly
# in docker-compose.yml (http://alloy:4318) since it's a fixed, non-secret,
# local-network value now. Grafana Cloud credentials moved to alloy/.env --
# see alloy/.env.example. The backend no longer authenticates to Grafana
# Cloud directly.
