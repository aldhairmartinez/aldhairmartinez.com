# Copy this file to alloy/.env for local development.
# alloy/.env is gitignored — real credentials must never be committed.
#
# Get these from Grafana Cloud's OpenTelemetry/Application Observability
# setup page. Use the three separate plain values below, NOT the
# OTEL_EXPORTER_OTLP_HEADERS string the page generates for the Python SDK —
# that value's "Basic%20" encoding is meant for a Python client to parse,
# not a raw header. Alloy's otelcol.auth.basic component builds the Basic
# Auth header itself from the plain Instance ID and token, so do not
# pre-encode or pre-combine anything here.

# OTLP endpoint, e.g. https://otlp-gateway-prod-us-central-0.grafana.net/otlp
GRAFANA_CLOUD_OTLP_ENDPOINT=

# Plain Instance ID (not base64).
GRAFANA_CLOUD_OTLP_INSTANCE_ID=

# Plain Access Policy token (not base64). Never commit a real value — this
# must only ever exist in alloy/.env.
GRAFANA_CLOUD_OTLP_TOKEN=
